# URL của frontend. Mặc định local để tránh ghi nhầm lên môi trường từ xa.
E2E_BASE_URL=http://localhost:5173
E2E_BROWSER=chrome
# Tùy chọn khi máy không cho Selenium Manager tải mạng hoặc Chrome vừa cập nhật.
E2E_DRIVER_PATH=
E2E_HEADLESS=true
E2E_TIMEOUT_SECONDS=25
E2E_PAGE_LOAD_SECONDS=60
# PDF scan/OCR có thể cần lâu hơn request giao diện thông thường.
E2E_SUBMIT_TIMEOUT_SECONDS=180
E2E_IGNORE_CERTIFICATE_ERRORS=false

# Hai cờ bảo vệ thao tác tạo/sửa dữ liệu.
E2E_ALLOW_WRITES=false
E2E_ALLOW_REMOTE_WRITES=false

# Dùng lại E2E_RUN_ID để tiếp tục cùng bộ tài khoản test sau khi lượt chạy gián đoạn.
E2E_RUN_ID=
E2E_CANDIDATE_COUNT=15
E2E_CANDIDATE_EMAIL_DOMAIN=example.test
# Mã lô không nhạy cảm. Đổi giá trị này khi cần tiếp tục checkpoint bằng tài khoản mới.
E2E_CANDIDATE_BATCH_TAG=
E2E_CANDIDATE_PASSWORD=
# Chỉ bật khi chạy một candidate_batch_tag mới; mật khẩu được sinh trong RAM và không lưu lại.
E2E_AUTO_GENERATE_CANDIDATE_PASSWORD=false

# Chọn tin đang tuyển thật trên môi trường cần kiểm thử. Ưu tiên ID nếu có.
E2E_TARGET_JOB_ID=
E2E_TARGET_JOB_TITLE=Backend Developer
E2E_BENCHMARK_JOB_ID=job--information-technology--backend-developer--junior

# Chỉ điền tài khoản kiểm thử, không commit tệp .env.
E2E_HR_EMAIL=
E2E_HR_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# create-jobs: tạo bằng form HR; đặt false nếu muốn tự duyệt trên Admin.
E2E_JOB_COUNT=24
E2E_APPROVE_CREATED_JOBS=false

# Ma trận theo từng tin: cố định 20 CV/tin; mặc định mỗi lượt chỉ xử lý 1 tin
# để tránh đẩy đồng thời hàng trăm tác vụ OCR/AI. Giữ RUN_ID để chạy tiếp.
E2E_APPLICATIONS_PER_JOB=20
E2E_APPLICATION_JOB_BATCH_SIZE=1
E2E_APPLICATION_PAUSE_SECONDS=5
# Tối đa 4 trình duyệt; mỗi worker nhận các job riêng và dùng chung checkpoint có khóa.
E2E_APPLICATION_WORKERS=1
E2E_REUSE_CANDIDATE_ACCOUNTS=false

E2E_SOURCING_DOMAIN=Công nghệ thông tin
E2E_SOURCING_POSITION=Backend Developer

# 0: chỉ xác nhận nhận hồ sơ; >0: chờ trang Đơn ứng tuyển hết trạng thái đang phân tích.
E2E_WAIT_AI_SECONDS=0
