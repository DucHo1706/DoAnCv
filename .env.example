# Copy this file to .env on the VPS and replace every placeholder.
GEMINI_API_KEY=replace_me
GEMINI_MODELS=gemini-3.6-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_VISION_MODELS=gemini-3.6-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_KEY_COOLDOWN_SECONDS=60
DB_CONNECTION_STRING=replace_me
JWT_KEY=replace_me_with_a_long_random_key
EMAIL_PASSWORD=replace_me
EMAIL_ADDRESS=replace_me@example.com
CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me

# Optional. Prefer an absolute VPS path, for example /opt/recruitment/data/uploads.
UPLOADS_PATH=./Uploads

# Optional container limits. Adjust these to the VPS capacity.
AI_MEMORY_LIMIT=2g
AI_CPU_LIMIT=1.5
BACKEND_MEMORY_LIMIT=1g
BACKEND_CPU_LIMIT=1.0
FRONTEND_MEMORY_LIMIT=256m
FRONTEND_CPU_LIMIT=0.5

# Optional 9Router fallback. Keep these commented until a persistent SQLite
# volume and the corresponding credentials have been configured securely.
# ENABLE_9ROUTER=true
# NINE_ROUTER_IMAGE=decolua/9router:0.5.55
# NINE_ROUTER_JWT_SECRET=replace_me
# NINE_ROUTER_API_KEY_SECRET=replace_me
# NINE_ROUTER_MACHINE_ID_SALT=replace_me
# NINE_ROUTER_INITIAL_PASSWORD=replace_me
# LLM_ROUTER_BASE_URL=http://9router:20128/v1
# LLM_ROUTER_API_KEY=replace_me
# LLM_ROUTER_MODELS=Gemini,deepseek,ag/gemini-3.5-flash-low
# LLM_ROUTER_TIMEOUT_SECONDS=25
# LLM_ROUTER_TOTAL_BUDGET_SECONDS=25
# LLM_ROUTER_COOLDOWN_SECONDS=120
