{
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_DATABASE_HOST; Database=YOUR_DATABASE_NAME; User Id=YOUR_DATABASE_USER; Password=YOUR_DATABASE_PASSWORD; Encrypt=True; TrustServerCertificate=True; MultipleActiveResultSets=True;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cloudinary": {
    "CloudName": "YOUR_CLOUDINARY_CLOUD_NAME",
    "ApiKey": "YOUR_CLOUDINARY_API_KEY",
    "ApiSecret": "YOUR_CLOUDINARY_API_SECRET"
  },
  "GoogleDrive": {
    "CredentialFile": "google-credentials.json",
    "FolderId": "YOUR_GOOGLE_DRIVE_FOLDER_ID"
  },
  "Jwt": {
    "Key": "YOUR_SECURE_JWT_SECRET_KEY_MINIMUM_32_CHARS",
    "Issuer": "RecruitmentApp",
    "Audience": "RecruitmentAppUsers"
  },
  "EmailSettings": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "SenderEmail": "YOUR_EMAIL@gmail.com",
    "SenderName": "AI Recruitment",
    "Username": "YOUR_EMAIL@gmail.com",
    "Password": "YOUR_SMTP_APP_PASSWORD",
    "EnableSsl": true
  },
  "AllowedHosts": "*"
}
